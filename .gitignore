# --- Build output (regenerated by cargo / vite / esbuild) ---
target/
dist/
node_modules/
*.tsbuildinfo
.vite/

# Tauri: generated schemas and the sidecar copied in by scripts/build.ps1
app/src-tauri/gen/
app/src-tauri/binaries/

# --- Vault data: never commit real or test vaults/backups ---
*.rahsa
*.rahsa.*
pairing.dat
Rahsa-Emergency-Kit*.html

# --- Secrets: code-signing certificates, keys, env files ---
*.pfx
*.p12
*.pem
*.key
.env
.env.*

# --- Logs and OS/editor clutter ---
*.log
npm-debug.log*
Thumbs.db
desktop.ini
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Release artifacts gathered by scripts/build.ps1
release/
