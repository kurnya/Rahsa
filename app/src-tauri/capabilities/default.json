{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the Rahsa commands, events and native file dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
