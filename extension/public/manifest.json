{
  "manifest_version": 3,
  "name": "Rahsa",
  "version": "0.1.0",
  "description": "Isi form login web institusi dengan akun dari aplikasi Rahsa di laptop Anda.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "activeTab", "storage", "scripting", "browsingData"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Rahsa",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/locked-16.png", "32": "icons/locked-32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Pilih akun Rahsa untuk halaman ini"
    }
  },
  "incognito": "spanning",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
